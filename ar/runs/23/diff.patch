+diff --git a/bla_gpt/attentions.py b/bla_gpt/attentions.py
+index e298e55..ae9ced9 100644
+--- a/bla_gpt/attentions.py
++++ b/bla_gpt/attentions.py
+@@ -173,6 +173,13 @@ class Attention(nn.Module):
+         # Causal mask
+         self.mask = None
+ 
++        # Value embeddings: learnable per-layer scalar gate (scalar -> AdamW
++        # in the Muon param split). Only used when `ve` is passed to forward.
++        if getattr(config, "use_value_embeddings", False):
++            self.ve_lambda = nn.Parameter(
++                torch.tensor(float(getattr(config, "value_emb_lambda_init", 0.5)))
++            )
++
+         self.set_layers(config)
+ 
+     def set_layers(self, config):
+@@ -188,7 +195,7 @@ class Attention(nn.Module):
+         # Output projection
+         self.c_proj = nn.Linear(config.n_embd, config.n_embd, bias=config.bias)
+ 
+-    def forward(self, x, q=None, mask=None):
++    def forward(self, x, q=None, mask=None, ve=None):
+         B, T, C = x.size()
+         T_q = q.size(1) if q is not None else T
+ 
+@@ -202,6 +209,11 @@ class Attention(nn.Module):
+         q = self._project_query(q if q is not None else x, B, T_q)
+         k, v = self._project_kv(x, B, T)
+ 
++        # Value embeddings: add gated token-value embedding into V
++        # (modded-nanogpt lineage). ve: (B, T, n_embd)
++        if ve is not None:
++            v = v + self.ve_lambda * ve.view(B, T, self.n_kv_head, self.head_dim)
++
+         # Apply normalization and rotary embeddings if configured
+         if hasattr(self, "q_norm"):
+             q, k = self._apply_norm(q, k)
+diff --git a/bla_gpt/bla_gpt.py b/bla_gpt/bla_gpt.py
+index d209cc1..fcfe9eb 100644
+--- a/bla_gpt/bla_gpt.py
++++ b/bla_gpt/bla_gpt.py
+@@ -109,6 +109,13 @@ class GPTConfig(Coqpit):
+     )
+     per_layer_token_emb_dim: int = 256  # Dimension of the per-layer token embedding, if use_per_layer_token_emb is True
+ 
++    # Value embeddings (modded-nanogpt lineage): shared token->n_embd embedding
++    # added into the attention V projection at selected layers, gated by a
++    # learnable per-layer scalar lambda.
++    use_value_embeddings: bool = False
++    value_emb_layers: list[int] = field(default_factory=list)  # empty = first 3 + last 3 layers
++    value_emb_lambda_init: float = 0.5
++
+     # Engram: N-gram hash memory lookup
+     # Variants: "ngram_lambda" (model-level lambda mixing), "simple" (SimpleEngram), "minimal" (MinimalEngram)
+     use_engram: bool = False
+@@ -384,6 +391,15 @@ class Block(nn.Module):
+         self.ln_2 = get_norm(config)
+         self.mlp = get_mlp(config, depth)  # Pass depth for STEM layer selection
+ 
++        # Value embeddings: is this layer selected for V injection?
++        self.use_ve = False
